import matplotlib.pyplot as plt
import seaborn as sns

df = sns.load_dataset("tips")
col = df["total_bill"]
plt.figure(figsize=(6, 4))
sns.histplot(data=df, x="total_bill", bins=15)
plt.title("Histogram of Total Bill")
plt.show()
plt.figure(figsize=(6, 4))
sns.kdeplot(data=df, x="total_bill", fill=True)
plt.title("KDE Plot of Total Bill")
plt.show()
plt.figure(figsize=(6, 4))
sns.rugplot(data=df, x="total_bill", height=0.15)
plt.title("Rug Plot of Total Bill")
plt.show()
plt.figure(figsize=(6, 4))
sns.histplot(data=df, x="total_bill", bins=15, kde=True)
plt.title("Histogram with KDE of Total Bill")
plt.show()
