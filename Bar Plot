import matplotlib.pyplot as plt
import pandas as pd

# Load dataset and aggregate by Category
df = pd.read_csv(r"C:\Users\LENOVO\Downloads\sales_data.csv")

date_sales = df.groupby("Date")["Sales"].sum()

# 1. Vertical Bar Chart
plt.figure(figsize=(8, 4))
plt.bar(
    date_sales.index,
    date_sales.values,
    color=["#4C72B0", "#55A868", "#C44E52"]
)
plt.title("Total Sales by Date (Vertical)", fontsize=14)
plt.xlabel("Date", fontsize=12)
plt.ylabel("Total Sales ($)", fontsize=12)
plt.tight_layout()
plt.show()

# 2. Horizontal Bar Chart
plt.figure(figsize=(8, 4))
plt.barh(
    date_sales.index,
    date_sales.values,
    color=["#4C72B0", "#55A868", "#C44E52"],
)
plt.title("Total Sales by Date (Horizontal)", fontsize=14)
plt.xlabel("Total Sales ($)", fontsize=12)
plt.ylabel("Date", fontsize=12)
plt.tight_layout()
plt.show()
